# =============================================================================
#  ФАБРИКА КОНТЕНТА — конфигурация
#  Все переменные задаются через переменные окружения (.env / GitHub Secrets)
# =============================================================================

# ---------------------- Telegram Bot API ----------------------
# Токен бота от @BotFather. Бот должен быть добавлен админом в канал.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# @username канала или chat_id (например @mychannel)
TELEGRAM_CHANNEL=@mychannel

# ---------------------- Meta Graph API (Facebook / Instagram) ----------------------
# Long-lived page access token (Facebook App + Business). См. README.
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token
# ID страницы Facebook (число)
META_PAGE_ID=your_meta_page_id
# ID профиля Instagram (число). Instagram-аккаунт должен быть связан со страницей.
META_INSTAGRAM_ID=your_instagram_id

# ---------------------- LLM (генерация контента) ----------------------
# Провайдер: "openai" | "anthropic" | "none" (none = пул/шаблоны без внешних API)
CONTENT_LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini
# OpenAI-совместимый эндпоинт (прокси/шлюз), если api.openai.com недоступен в вашем регионе
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=your_anthropic_key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---------------------- Генерация изображений (DALL-E / YandexART) ----------------------
# Включить генерацию/редактирование картинок через API: on | off
IMAGE_GENERATION=off
# Провайдер изображений: "openai" (DALL-E) | "yandex" (YandexART)
IMAGE_PROVIDER=openai
# Модель OpenAI для изображений (если провайдер openai)
# OPENAI_IMAGE_MODEL=dall-e-3

# ---------------------- Маскот и баннер ----------------------
# Файл маскота компании (используется в приоритете над генерацией API)
# CONTENT_MASCOT_FILE=/path/to/mascot.jpg
# Баннер: маскот + текст поста на картинке (локально, без API): on | off
CONTENT_BANNER=off
#
# Режимы картинок (приоритет в resolvePostImage):
#  1. CONTENT_BANNER=on + CONTENT_MASCOT_FILE → маскот + текст поста (баннер)
#  2. IMAGE_GENERATION=on + IMAGE_PROVIDER=yandex + CONTENT_MASCOT_FILE →
#     маскот МОДИФИЦИРУЕТСЯ YandexART промтом под тему поста
#  3. CONTENT_MASCOT_FILE (без баннера/генерации) → маскот как есть
#  4. IMAGE_GENERATION=on без маскота → генерация с нуля

# ---------------------- Yandex Cloud (YandexART) ----------------------
# Ключ API и ID каталога из Яндекс Облака (см. https://console.yandex.cloud)
YANDEX_API_KEY=your_yandex_api_key
YANDEX_KEY_ID=your_yandex_key_id
YANDEX_FOLDER_ID=your_yandex_folder_id

# ---------------------- Публичное хранилище изображений (для Instagram) ----------------------
# s3 (S3-совместимое хранилище) | placeholder (заглушка — Instagram не получит картинку)
IMAGE_STORAGE=s3
# S3 (AWS) — доступы. Bucket должен разрешать public-read объекты.
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name

# ---------------------- Расписание ----------------------
# Часовой пояс, в котором задано расписание
CONTENT_TIMEZONE=Europe/Moscow
# Окно публикации: слот считается актуальным в течение N минут после запланированной минуты
# (компенсирует задержки cron). По умолчанию 10.
# PUBLICATION_WINDOW_MIN=10
# Слот, пропущенный дольше N минут, НЕ навёрстывается (защита от спама в конце дня). По умолчанию 180.
# MISSED_SLOT_MAX_MIN=180
# Ручной режим: навёрстывать любые пропущенные слоты дня (FORCE_MISSED_POSTS=1). Для тестов/разовых публикаций.
# FORCE_MISSED_POSTS=0
# Хранилище состояния (для GitHub Actions это всегда "fs", данные в data/state.json)
CONTENT_STATE_STORAGE=fs
# Хранилище медиа (локальная папка; для CI можно подключить s3)
CONTENT_MEDIA_STORAGE=fs
